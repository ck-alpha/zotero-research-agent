{
  "name": "llm-for-zotero",
  "type": "module",
  "version": "3.9.5",
  "description": "AI research agent rooted in your Zotero library",
  "config": {
    "addonName": "llm-for-zotero",
    "addonID": "zotero-llm@github.com.yilewang",
    "addonRef": "llmforzotero",
    "addonInstance": "LLMForZotero",
    "prefsPrefix": "extensions.zotero.llmforzotero"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yilewang/llm-for-zotero.git"
  },
  "author": "Yile Wang",
  "bugs": {
    "url": "https://github.com/yilewang/llm-for-zotero/issues"
  },
  "homepage": "https://github.com/yilewang/llm-for-zotero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && npm run typecheck",
    "check:cycles": "node scripts/check-import-cycles.cjs",
    "validate:model-registry": "node scripts/validate-model-capability-registry.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:workflow",
    "test:unit": "npx tsx node_modules/mocha/bin/mocha.js --require ./test/register.cjs 'test/**/*.test.ts'",
    "test:workflow": "node scripts/run-workflow-tests.mjs",
    "test:webchat:live": "node scripts/run-workflow-tests.mjs --webchat-live",
    "update-deps": "npm update --save",
    "test:agent:live": "node scripts/run-workflow-tests.mjs --agent-live"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.5",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.1",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
